  KeyPadCam: {fileID: 1274117306}
  DoorCam: {fileID: 910999389}
  backAction: {fileID: 7081251082610794201, guid: 97210cd740af04df697b1fa71c9c9623, type: 3}
  CodeText: {fileID: 520504404}
  CorrectCode: 85163427
  KeyPadAS: {fileID: 1246611719}
  CorrectSound: {fileID: 8300000, guid: d8e02746e2390364497d156a56067a39, type: 3}
  WrongSound: {fileID: 8300000, guid: c6a05e3cbd1f22742886da0da02684c5, type: 3}
  GreenLight: {fileID: 735461155}
  RedLight: {fileID: 725242694}
  CodePreview: {fileID: 1828718917}
  keypadRaycaster: {fileID: 1246611715}
  firstDialogueLines:
  - "\xA1Superaste el desaf\xEDo!"
  - "Siempre debes tener en cuenta el reglamento de un laboratorio antes de ingresar,
    aseg\xFArate de cumplir todas las normas."
  - 'Has ganado el Concepto de seguridad: Normas de Laboratorio.'
  - "Gu\xE1rdalo, quien sabe, podr\xEDa servirte en un futuro. "
  errorDialogueLines:
  - "cometiste un error, tienes que mirar en tu entorno, te dar\xE9 una pista para
    que logres superar el desaf\xEDo."
  - "\u201CAntes de buscar n\xFAmeros, busca lo que est\xE1 delante. Ocho guardianes
    protegen el laboratorio. Cada uno tiene una letra que no est\xE1 all\xED por
    casualidad. L\xE9elas en el orden en que aparecen y descubrir\xE1s la primera
    llave.\u201D "
  errorSingleLine: "\u201CAntes de buscar n\xFAmeros, busca lo que est\xE1 delante.
    Ocho guardianes protegen el laboratorio. Cada uno tiene una letra que no est\xE1
    all\xED por casualidad. L\xE9elas en el orden en que aparecen y descubrir\xE1s
    la primera llave.\u201D "
  gameManager: {fileID: 1259816875}
  doorScript: {fileID: 844465162}
