  m_Script: {fileID: 11500000, guid: 1d50ce2fb7f2a3d4aa9942bfac4ae5a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::S_0_Intro
  alarmLight: {fileID: 743945659}
  alarmAS: {fileID: 422425283}
  alarmSound: {fileID: 8300000, guid: d4248f220b3104e44aed200d7de864a4, type: 3}
  firstDialogueLines:
  - "Durante a\xF1os, tu objetivo fue claro."
  - Educar a futuras generaciones y convertirte en profesor de ciencias.
  - "Tras un largo periodo de estudio y superar los procesos de admisi\xF3n, lograste
    ingresar a la universidad en la carrera que quer\xEDas."
  - "Hoy es tu primer d\xEDa tu primera asignatura fundamental: Biolog\xEDa B\xE1sica
    y Celular."
  - "[Desafiante] El laboratorio est\xE1 a tu disposici\xF3n."
  - "[Desafiante] Les recomiendo visitarlo de manera aut\xF3noma cuando finalice
    esta sesi\xF3n, para familiarizarse con el entorno y el equipamiento."
  secondDialogueLines:
  - "\xA1No tan r\xE1pido!"
  - "Para entrar al laboratorio, primero tendr\xE1s que descubrir el c\xF3digo de
    acceso."
  - "\xA1Observa bien tu entorno!"
  labDoorScript: {fileID: 844465162}
  gameManager: {fileID: 1259816875}
  playButton: {fileID: 1499633558}
  Acertijo1: {fileID: 206454777}
